{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smc-platform.local/schemas/evidence_packet.schema.json",
  "title": "Evidence Packet Schema",
  "description": "전문 보고서·교재 제작 플랫폼의 단일 근거 패킷(evidence_packet.json) 표준 스키마",
  "type": "object",
  "required": [
    "packet_id",
    "created_at",
    "sources"
  ],
  "properties": {
    "packet_id": {
      "type": "string",
      "description": "패킷 식별자 (예: ch01_evidence)"
    },
    "topic": {
      "type": "string",
      "description": "대상 주제 또는 단원명"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "storage_root": {
      "type": "string",
      "description": "물리 수집 자료 저장소 루트 (기본 E:/SMC_Report_Platform_Data)"
    },
    "kg_store_root": {
      "type": "string",
      "description": "지식그래프 저장소 루트 (기본 C:/SMC_GRAPHRAG)"
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source_item"
      }
    }
  },
  "$defs": {
    "source_item": {
      "type": "object",
      "required": [
        "source_id",
        "url",
        "title",
        "accessed_at",
        "robots_allowed",
        "license_note",
        "page_or_section",
        "extracted_facts",
        "tables",
        "sha256"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "pattern": "^SRC-[0-9]{2,4}$",
          "description": "고유 출처 키 (예: SRC-01)"
        },
        "source_type": {
          "type": "string",
          "enum": ["web", "pdf", "docx", "hwp", "hwpx", "xlsx", "pptx", "txt", "md", "kg_reuse"]
        },
        "url": {
          "type": "string",
          "description": "원천 URL 또는 file:// 로컬 경로"
        },
        "title": {
          "type": "string"
        },
        "accessed_at": {
          "type": "string",
          "format": "date-time"
        },
        "robots_allowed": {
          "type": "boolean"
        },
        "robots_status": {
          "type": "string"
        },
        "license_note": {
          "type": "string"
        },
        "page_or_section": {
          "type": "string",
          "description": "페이지 범위 또는 절 정보 (예: p.1-12 또는 본문 전체)"
        },
        "raw_path": {
          "type": "string",
          "description": "E:\\SMC_Report_Platform_Data\\raw\\ 하위 원본 저장 경로"
        },
        "parsed_path": {
          "type": "string",
          "description": "E:\\SMC_Report_Platform_Data\\parsed\\ 하위 정제 마크다운 경로"
        },
        "pii_masked": {
          "type": "boolean",
          "default": true
        },
        "pii_redaction_count": {
          "type": "integer",
          "minimum": 0,
          "default": 0
        },
        "prompt_injection_warnings": {
          "type": "array",
          "items": { "type": "string" },
          "default": []
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "extracted_facts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["claim"],
            "properties": {
              "claim": { "type": "string" },
              "metric": { "type": "string" },
              "value": { "type": "string" },
              "as_of_date": { "type": "string" },
              "page_or_section": { "type": "string" },
              "evidence_quote_short": { "type": "string" }
            }
          }
        },
        "tables": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "table_id": { "type": "string" },
              "caption": { "type": "string" },
              "page_or_section": { "type": "string" },
              "headers": {
                "type": "array",
                "items": { "type": "string" }
              },
              "rows": {
                "type": "array",
                "items": {
                  "type": "array",
                  "items": { "type": "string" }
                }
              }
            }
          }
        },
        "chunks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["chunk_id", "text", "page_or_section"],
            "properties": {
              "chunk_id": { "type": "string" },
              "text": { "type": "string" },
              "page_or_section": { "type": "string" },
              "char_count": { "type": "integer" }
            }
          }
        }
      }
    }
  }
}
