# =============================================================================
# Eco-Browser / Ego-Browser 기반 전문 보고서·교재 제작 플랫폼 환경 설정
# =============================================================================

# 1. 저장소 경로 (수집 자료 -> E:\, 지식그래프 -> C:\SMC_GRAPHRAG)
COLLECTED_DATA_ROOT=E:/SMC_Report_Platform_Data
SMC_GRAPHRAG_ROOT=C:/SMC_GRAPHRAG
LIGHTRAG_WORKING_DIR=C:/SMC_GRAPHRAG/lightrag_store
WORKING_DIR=C:/SMC_GRAPHRAG/lightrag_store

# LightRAG 도메인 워크스페이스 ($로 시작 금지)
WORKSPACE=smc_default

# 2. 로컬 Ollama (Gemma 4 26B A4B + BGE-M3)
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_FLASH_ATTENTION=1
OLLAMA_LLM_MODEL=gemma4:26b
# 참고: 16GB VRAM 환경에서 초고속 100% GPU 전용이 필요하면 gemma4:latest 로 전환 가능
OLLAMA_FAST_MODEL=gemma4:latest
OLLAMA_EMBED_MODEL=bge-m3
OLLAMA_NUM_CTX=32768

# 3. LightRAG Server 바인딩 설정 (http://127.0.0.1:9621/webui)
HOST=127.0.0.1
PORT=9621
LIGHTRAG_API_URL=http://127.0.0.1:9621
LLM_BINDING=ollama
LLM_BINDING_HOST=http://127.0.0.1:11434
LLM_MODEL=gemma4:26b
OLLAMA_LLM_NUM_CTX=32768
EMBEDDING_BINDING=ollama
EMBEDDING_BINDING_HOST=http://127.0.0.1:11434
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024
MAX_ASYNC=2
MAX_TOKENS=32768
CHUNK_SIZE=1200
CHUNK_OVERLAP_SIZE=150
ENABLE_LLM_CACHE=true
ENABLE_LLM_CACHE_FOR_ENTITY_EXTRACT=true

# 4. 기존 C:\SMC_GRAPHRAG Neo4j 연동 (선택: Docker Neo4j 기동 시 활성화)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
# NEO4J_PASSWORD 는 C:\SMC_GRAPHRAG\.env 에서 자동 상속하거나 여기에 설정
